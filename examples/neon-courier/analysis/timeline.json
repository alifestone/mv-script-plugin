 "lyrics": [
  {"id": 1, "t_start": 2.0, "t_end": 6.0, "frame_start": 48, "frame_end": 144, "text": "雨還沒停，城市先亮了", "bar_start": 1, "bar_end": 2, "section": "intro"},
  {"id": 2, "t_start": 10.0, "t_end": 14.0, "frame_start": 240, "frame_end": 336, "text": "背包裡有一封沒署名的信", "bar_start": 5, "bar_end": 6, "section": "verse"},
  {"id": 3, "t_start": 18.0, "t_end": 22.0, "frame_start": 432, "frame_end": 528, "text": "地圖上的路，只有我自己會走", "bar_start": 9, "bar_end": 10, "section": "verse"},
  {"id": 4, "t_start": 26.0, "t_end": 30.0, "frame_start": 624, "frame_end": 720, "text": "跑吧，趕在燈熄滅以前", "bar_start": 13, "bar_end": 14, "section": "chorus"},
  {"id": 5, "t_start": 34.0, "t_end": 38.0, "frame_start": 816, "frame_end": 912, "text": "每一盞霓虹都替我指路", "bar_start": 17, "bar_end": 18, "section": "chorus"},
